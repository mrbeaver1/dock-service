# Development-only application settings
HOST_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
ADMIN_TOKEN=change_me_admin_token
RPS=100
BURST=200

# PostgreSQL connection settings for a locally run application
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dock_service
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=dock_service
# Local PostgreSQL runs without TLS.
POSTGRES_SSL_MODE=disable

# Redis connection settings for a locally run application
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# S3 connection settings for a locally run application
S3_HOST=localhost
S3_API_PORT=9102
S3_CONSOLE_PORT=9103
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio_password
# Created by s3-init; anonymous downloads are enabled for this entire bucket.
S3_BUCKET=documents
